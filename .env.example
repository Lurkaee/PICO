# PICO Environment Configuration Example
# Copy to .env for local overrides. Never commit actual secret keys.

# System & Persistence
PROJECT_NAME=PICO
VERSION=0.1.0
DATABASE_URL=sqlite:///./pico.db
ENVIRONMENT=development
LOG_LEVEL=INFO

# Active Default Provider ("mock", "ollama", "cloud")
DEFAULT_PROVIDER=mock

# Local Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_TIMEOUT_SECONDS=60.0

# Cloud Configuration (Strictly disabled by default)
CLOUD_ENABLED=false
# CLOUD_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini
CLOUD_TIMEOUT_SECONDS=60.0

# Home Assistant Integration (Strictly disabled by default)
# Never commit long-lived access tokens to version control.
HOME_ASSISTANT_ENABLED=false
HOME_ASSISTANT_BASE_URL=http://127.0.0.1:8123
# HOME_ASSISTANT_ACCESS_TOKEN=your_long_lived_access_token_here
HOME_ASSISTANT_TIMEOUT_SECONDS=10.0
# Allow plain HTTP/WS transport to non-loopback hosts (strictly false by default)
HOME_ASSISTANT_ALLOW_INSECURE_TRANSPORT=false

# Milestone P7.3 Physical Actuation Settings (Strictly disabled by default)
# Only a single, explicitly configured test light may ever be actuated.
HOME_ASSISTANT_ACTUATION_ENABLED=false
# HOME_ASSISTANT_P7_TEST_LIGHT_ENTITY_ID=light.test_light
HOME_ASSISTANT_ACTUATION_TIMEOUT_SECONDS=5.0
HOME_ASSISTANT_VERIFICATION_TIMEOUT_SECONDS=5.0
HOME_ASSISTANT_VERIFICATION_POLL_INTERVAL_SECONDS=0.5

# Milestone P7.4.1 Stage C Switch Physical Actuation Settings (Strictly disabled by default)
# Only explicitly configured, individually allowlisted switch.* entities may ever be actuated.
HOME_ASSISTANT_SWITCH_ACTUATION_ENABLED=false
# HOME_ASSISTANT_SWITCH_ALLOWLIST='["switch.desk_lamp_plug", "switch.bench_test_plug"]'

# Milestone P7.4.2 Stage D Climate Awareness & Actuation Settings (Strictly disabled by default)
# Only explicitly configured, individually allowlisted climate.* entities may ever be observed or actuated.
HOME_ASSISTANT_CLIMATE_AWARENESS_ENABLED=false
# HOME_ASSISTANT_CLIMATE_ALLOWLIST='["climate.living_room_thermostat"]'
# HOME_ASSISTANT_CLIMATE_GRID_ORIGINS='{"climate.living_room_thermostat": {"origin": 16.0, "unit": "°C"}}'
HOME_ASSISTANT_CLIMATE_ACTUATION_ENABLED=false
HOME_ASSISTANT_CLIMATE_DUAL_SETPOINT_ACTUATION_ENABLED=false
