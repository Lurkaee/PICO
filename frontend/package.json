{
  "name": "pico-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode browser-development",
    "dev:tauri": "vite --mode managed-desktop --host localhost --port 1420 --strictPort",
    "build": "tsc -b && vite build --mode packaged-production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  }
}
